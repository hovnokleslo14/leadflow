# LeadFlow Dashboard - Pelican Environment Variables
# Zkopíruj do Pelicanu: Applications → [tvoje app] → Environment Variables
# NEBO: nastav v .env pro lokální docker-compose

# ================================================================
# 🔴 POVINNÉ - bez toho to nepoběží
# ================================================================

# PostgreSQL connection string (asyncpg driver)
# Formát: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Pokud používáš Pelican PostgreSQL addon: zkopíruj z addon detailu
DATABASE_URL=postgresql+asyncpg://leadflow:secure_password@host.docker.internal:5432/leadflow

# JWT signing key - minimálně 32 znaků
# Generuj: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# ================================================================
# 🟡 AI DRAFTY - volitelné, ale bez toho AI nefunguje
# ================================================================

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=sk-your-openai-key

# NEBO Anthropic (Claude 3 Haiku/Sonnet)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Který provider použít: openai nebo anthropic
AI_PROVIDER=openai

# ================================================================
# 🟢 DISCORD BOT - volitelné
# ================================================================

# Bot token z Discord Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=your-bot-token

# OAuth2 Client ID z General Information
DISCORD_CLIENT_ID=123456789012345678

# OAuth2 Client Secret z General Information → Reset Secret
DISCORD_CLIENT_SECRET=your-client-secret

# Redirect URI - MUSÍ přesně odpovídat Discord Developer Portal → OAuth2 → Redirects
# Formát: https://TWOJE_DOMENA/auth/discord/callback
DISCORD_REDIRECT_URI=https://dashboard.tvoje-domena.cz/auth/discord/callback

# ================================================================
# 🔵 NOTIFIKACE - volitelné
# ================================================================

# Gotify server URL (pro push notifikace na mobil)
GOTIFY_URL=https://gotify.tvoje-domena.cz

# Gotify App Token (v Gotify: Apps → Create App → Token)
GOTIFY_TOKEN=your-gotify-app-token

# ================================================================
# 🟣 SCRAPING - volitelné
# ================================================================

# Reddit OAuth z https://www.reddit.com/prefs/apps
# Type: script, redirect: http://localhost:8080 (nepoužívá se)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-secret
REDDIT_USER_AGENT=LeadFlow/1.0

# ================================================================
# ⚙️ FRONTEND / CORS
# ================================================================

# URL kde běží frontend (pro CORS a Discord OAuth)
# MUSÍ končit bez /api
NEXT_PUBLIC_API_URL=https://dashboard.tvoje-domena.cz
FRONTEND_URL=https://dashboard.tvoje-domena.cz

# Povolené origin pro CORS (oddělené čárkou)
CORS_ORIGINS=https://dashboard.tvoje-domena.cz,https://www.tvoje-domena.cz

# ================================================================
# 🔴 REDIS - volitelné (pro Celery background tasks)
# ================================================================

# Pokud používáš Pelican Redis addon
REDIS_URL=redis://redis:6379/0

# ================================================================
# 👤 ADMIN
# ================================================================

# Admin uživatelské jméno (email)
ADMIN_USERNAME=admin

# Admin password hash - prázdné = vygeneruje se při prvním startu (admin123)
# Po prvním přihlášení ZMĚŇ HESLO v UI!
ADMIN_PASSWORD_HASH=

# ================================================================
# 🐳 INTERNÍ (neměnit)
# ================================================================

PYTHONUNBUFFERED=1
NODE_ENV=production