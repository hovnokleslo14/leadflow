# Application
APP_NAME="LeadFlow Dashboard"
APP_VERSION="1.0.0"
DEBUG=true
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL="sqlite+aiosqlite:///./leadflow.db"
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/leadflow"

# Admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""  # Will be generated on first run

# AI
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_PROVIDER="openai"  # openai or anthropic

# Discord Bot
DISCORD_BOT_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/auth/discord/callback"

# Gotify
GOTIFY_URL="https://your-gotify-server.com"
GOTIFY_TOKEN=""

# Scrapers
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="LeadFlow/1.0"

# Frontend
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5064"

# Server
BACKEND_PORT=8000
FRONTEND_PORT=3000